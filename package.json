{
  "name": "podverse-notifications",
  "version": "5.1.20",
  "description": "Push notification helper module for Podverse use cases",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build:watch": "nodemon --watch 'src' --watch $(realpath node_modules/podverse-external-services) --watch $(realpath node_modules/podverse-helpers) --delay 500ms -x \"npm run build\"",
    "build": "tsc",
    "lint": "eslint ./src --ext .ts",
    "start": "ts-node ./src/index.ts"
  },
  "author": "",
  "license": "AGPLv3",
  "dependencies": {
    "module-alias": "^2.2.3",
    "podverse-external-services": "^5.1.12",
    "podverse-helpers": "^5.1.12",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.21.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.4.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.35.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
