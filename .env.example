#####
##### podverse-notifications
#####

#####
##### Web Push (Native)
#####
# Native browser push notifications using W3C Push API (no third-party dependency)
# Generate keys with: npx web-push generate-vapid-keys

WEBPUSH_ENABLED= # true or undefined
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:contact@podverse.fm

#####
##### Website related
#####
# Used for notification links and icons

WEB_PROTOCOL=http
WEB_DOMAIN=localhost:3000
WEB_ICON_IMAGE_PATH=/favicon/web-app-manifest-192x192.png
